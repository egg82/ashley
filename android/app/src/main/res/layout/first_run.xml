<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/theme"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/first_run_title"
        android:textAppearance="@android:style/TextAppearance.Material.Headline" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/first_run_explain"
        android:textAppearance="@android:style/TextAppearance.Material.Body1" />

    <EditText
        android:id="@+id/address"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:autofillHints="url"
        android:hint="@string/first_run_hint"
        android:imeOptions="actionGo"
        android:inputType="textUri"
        android:singleLine="true"
        android:text="@string/first_run_prefix" />

    <TextView
        android:id="@+id/error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/first_run_error"
        android:textAppearance="@android:style/TextAppearance.Material.Body1"
        android:textColor="#FF8A80"
        android:visibility="gone" />

    <Button
        android:id="@+id/open"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="16dp"
        android:text="@string/first_run_open" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/first_run_change"
        android:textAppearance="@android:style/TextAppearance.Material.Caption" />
</LinearLayout>
