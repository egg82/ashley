<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The APK names no site: the person types it on first run (FirstRunActivity) and the app keeps it. -->
    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:manageSpaceActivity="io.github.egg82.ashley.SiteDataActivity"
        android:supportsRtl="true">

        <!-- Opens the saved site in a Trusted Web Activity; a phone with no TWA browser gets a Custom Tab (the library's
             default fallback). -->
        <activity
            android:name=".SiteLauncherActivity"
            android:exported="true">
            <meta-data
                android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR"
                android:resource="@color/theme" />
            <meta-data
                android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR_DARK"
                android:resource="@color/theme" />
            <!-- Without these the browser paints the gesture bar white under the dark page. -->
            <meta-data
                android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR"
                android:resource="@color/theme" />
            <meta-data
                android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR_DARK"
                android:resource="@color/theme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".FirstRunActivity"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <!-- LauncherActivity enables this class by name on every launch (its site-settings shortcut), so it must be
             declared: without it the app crashes at start ("Component class ... does not exist"). -->
        <activity android:name="com.google.androidbrowserhelper.trusted.ManageDataLauncherActivity" />

        <!-- The system's "Manage space" screen for the app: the browser's data for the saved site. -->
        <activity android:name=".SiteDataActivity" />
    </application>
</manifest>
