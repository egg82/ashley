# The image build123d model runs use (.gitlab-ci.yml, build-cad-image): Python slim, the OpenGL library build123d's
# OCP imports even with no display, the libraries gmsh's wheel loads (OpenGL utility, X11 client, OpenMP), build123d and
# gmsh at exact versions, and `ashley_cad`, the helper a model script ends with, with the print check it runs
# (`ashley_print`) and the weak-points study (`ashley_fea`, `ashley_fem`, `materials.json`). Tagged by a hash of this
# file and those (tools/ci_image_hash.py --cad); the build context is this directory.
# The pod runs as 65534 on a read-only root with no network.
FROM docker.io/library/python:3.13.18-slim@sha256:aaf08c5490d52cd92bc27142a5215b1e47355a5eaf9adfad2a0fbc022d0b5490
RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 libglu1-mesa libxcursor1 libxft2 libxinerama1 libgomp1 && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir build123d==0.13.0 gmsh==4.15.2
COPY ashley_cad.py ashley_print.py ashley_fea.py ashley_fem.py materials.json /usr/local/lib/python3.13/site-packages/
