# Copy to `.env` and fill in. Empty means off. Never commit `.env`.

# --- Compose itself -------------------------------------------------------------------------------------------
# Image tag to run: `dev` (latest main), a release version, or `latest`.
ASHLEY_TAG=dev
# Host port the app listens on.
ASHLEY_PORT=8080

# --- Core -----------------------------------------------------------------------------------------------------
# Postgres. Change the password in both places, or leave both as they are on a machine only you reach.
POSTGRES_PASSWORD=ashley
DATABASE_URL=postgresql://ashley:ashley@postgres:5432/ashley
# Seals each household's stored connections (32 random bytes, base64). Generate with:
#   openssl rand -base64 32
# or: python3 -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
CONNECTIONS_KEY=
# The address people reach her at, no trailing slash. Needed for sign-in and OAuth callbacks.
PUBLIC_URL=
# Who runs this and for whom, shown on the privacy and terms pages: Sam Doe for the Doe household
OPERATOR_NAME=
OPERATOR_CONTACT=

# --- Models: set at least one ---------------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# An OpenAI-compatible server of your own, e.g. http://host.docker.internal:11434/v1
LOCAL_LLM_URL=
LOCAL_LLM_API_KEY=

# --- Sign-in for the web app (all three, or none) -------------------------------------------------------------
# The web app signs in through an OIDC provider; Authentik is what it is built against. Needs PUBLIC_URL.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# --- Layer: files (profile `files`) ---------------------------------------------------------------------------
# All five of the FILES_* settings, or none. The garage and garage-init services read the same values.
FILES_ENDPOINTS=
FILES_BUCKET=
# `GK` followed by 24 hex characters: echo "GK$(openssl rand -hex 12)"
FILES_ACCESS_KEY=
# 64 hex characters: openssl rand -hex 32
FILES_SECRET_KEY=
# Signs download links; 32 or more characters: openssl rand -base64 32
FILES_LINK_KEY=
# The Garage container's own secrets: openssl rand -hex 32, and any long random string
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=

# --- Opt-in: code running through podman (see deploy/compose/README.md; no gVisor, the host's own kernel) ------
# SANDBOX_PODMAN=trusted
# CONTAINER_HOST=unix:///run/user/1000/podman/podman.sock

# --- Layer: search (profile `search`) -------------------------------------------------------------------------
# Set to http://searxng:8080 once the profile is on.
SEARXNG_URL=
# SearXNG's own secret key: openssl rand -hex 32
SEARXNG_SECRET=

# --- Layer: voice (profile `voice`) ---------------------------------------------------------------------------
# Set to tcp://whisper:10300 once the profile is on.
WYOMING_STT_URL=
# faster-whisper model and spoken language for the whisper service.
WHISPER_MODEL=small-int8
WHISPER_LANGUAGE=en
# Text to speech.
ELEVENLABS_API_KEY=
# Where satellites and room speakers fetch her spoken replies; needs ESPHOME_NOISE_PSK.
VOICE_CLIP_BASE_URL=
ESPHOME_NOISE_PSK=

# --- Optional, no extra service -------------------------------------------------------------------------------
DISCORD_BOT_TOKEN=
# Lets a signed-in person link their Discord account (both or neither; needs PUBLIC_URL).
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
# Lets a person connect Google (both or neither; needs PUBLIC_URL).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Web Push identity: VAPID_SUBJECT is mailto:you@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
