# The image Proton Mail Bridge's pod runs (.gitlab-ci.yml, build-mail-bridge-image): Bridge's own release at an exact version
# and checksum, `pass` and GnuPG as its keychain, and the keeper (keeper*.py) with the gRPC stubs generated from the pinned
# bridge.proto, which is Bridge 3.27.1's internal/frontend/grpc/bridge.proto. Tagged by a hash of this file and the keeper's
# files (tools/ci_image_hash.py --bridge); the build context is this directory. The pod runs as uid 1000 on a read-only root
# with HOME and /tmp as volumes (app/ashley/mail/proton_pod.py).
FROM docker.io/library/debian:bookworm-slim@sha256:734a72b3d6142a71993b4bc580ca01d8ca687f77a2c422d96a961d3376b179bc
ARG BRIDGE_VERSION=3.27.1
ARG BRIDGE_SHA256=d69eab5674335a41428bf77bde6a9f85667867e2083205625a710f6948e54d86
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl \
 && curl -fsSL -o /tmp/bridge.deb "https://proton.me/download/bridge/protonmail-bridge_${BRIDGE_VERSION}-1_amd64.deb" \
 && echo "${BRIDGE_SHA256}  /tmp/bridge.deb" | sha256sum -c - \
 && apt-get install -y --no-install-recommends /tmp/bridge.deb pass gnupg python3 python3-venv openssl \
 && apt-get purge -y curl && apt-get autoremove -y \
 && rm -rf /var/lib/apt/lists/* /tmp/bridge.deb
RUN python3 -m venv /opt/venv && /opt/venv/bin/pip install --no-cache-dir grpcio==1.80.0 grpcio-tools==1.80.0
COPY bridge.proto keeper.py keeper_app.py keeper_files.py keeper_grpc.py keeper_link.py keeper_log.py keeper_process.py keeper_relay.py keeper_serve.py /opt/keeper/
RUN cd /opt/keeper && /opt/venv/bin/python -m grpc_tools.protoc -I. --python_out=. --grpc_python_out=. bridge.proto \
 && /opt/venv/bin/python -c "import keeper, keeper_process, bridge_pb2, bridge_pb2_grpc"
RUN useradd -m -u 1000 bridge
USER 1000
WORKDIR /opt/keeper
ENV PYTHONPATH=/opt/keeper PYTHONDONTWRITEBYTECODE=1
EXPOSE 8080 2143 2025
ENTRYPOINT ["/opt/venv/bin/python", "-c", "import keeper; raise SystemExit(keeper.main())"]
