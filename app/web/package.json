    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@preact/signals": "2.11.3",
    "highlight.js": "11.12.0",
    "mermaid": "11.17.2",
    "preact": "10.29.8",
    "preact-iso": "2.12.2",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/three": "0.170.0",
    "esbuild": "0.28.2",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
