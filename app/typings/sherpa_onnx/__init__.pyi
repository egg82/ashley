"""The part of sherpa-onnx's speaker-embedding API that `ashley.inference.sherpa_voiceprint` uses; the package ships no
type information."""

from collections.abc import Sequence

class SpeakerEmbeddingExtractorConfig:
    def __init__(self, model: str = ..., num_threads: int = ..., debug: bool = ..., provider: str = ...) -> None: ...

class OnlineStream:
    def accept_waveform(self, sample_rate: float, waveform: Sequence[float]) -> None: ...
    def input_finished(self) -> None: ...

class SpeakerEmbeddingExtractor:
    def __init__(self, config: SpeakerEmbeddingExtractorConfig) -> None: ...
    def create_stream(self) -> OnlineStream: ...
    def is_ready(self, stream: OnlineStream) -> bool: ...
    def compute(self, stream: OnlineStream) -> list[float]: ...
